SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
OPENCODE_PORT=1707
# Dashboard port. On a Hack Club Nest, 8787 is taken by the Nest status server — use 8788.
DASHBOARD_PORT=8787
# Interface the dashboard binds to (0.0.0.0 = all interfaces, reachable via subdomain/port-forward)
HOST=0.0.0.0
# PIN gate for the web dashboard (required before exposing via tunnel)
DASHBOARD_PIN=
# Optional: only allow these Slack user IDs (comma separated). Empty = allow everyone.
ALLOWED_USERS=
USE_REACTIONS=true
# Optional: channel ID to send bot log events to (new sessions, tool calls, replies, errors).
# Plain text only — never mentions users. Invite the bot to the channel first. Empty = disabled.
LOG_CHANNEL=
