# Cloudflare Tunnel config for the OpenCode Slack dashboard.
# Copy this to ~/.cloudflared/opencode-slack.yml and fill in YOUR tunnel id.
#
# Getting your tunnel id:
#   cloudflared tunnel login
#   cloudflared tunnel create opencode-slack
#   cloudflared tunnel route dns opencode-slack YOUR-HOSTNAME.example.com
#   (the command prints your tunnel UUID — use it below)

tunnel: YOUR-TUNNEL-UUID-HERE
credentials-file: /Users/YOURNAME/.cloudflared/YOUR-TUNNEL-UUID-HERE.json

ingress:
  # The public URL. Point it at the dashboard port (see DASHBOARD_PORT in .env).
  - hostname: opencode.example.com
    service: http://localhost:8787
  # Everything else gets a 404.
  - service: http_status:404
